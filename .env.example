# Only OPENAI_API_KEY is required. GEMINI_API_KEY and GROQ_API_KEY are
# optional automatic fallbacks: if the primary provider errors out (rate
# limit, outage, etc.) the app tries the next one that has a key set, in the
# order OpenAI -> Gemini -> Groq. Leave either fallback blank to skip it.

OPENAI_API_KEY=sk-...
# Optional: override the vision model (defaults to gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional fallback #1 (Google AI Studio key)
GEMINI_API_KEY=
# Optional: override the model (defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback #2 (console.groq.com key)
GROQ_API_KEY=
# Optional: override the model (defaults to a vision-capable Llama 4 model)
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct
